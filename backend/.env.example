# Google Gemini API Key (Required for LLM Resume Analysis & Enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Required for Production Database & Auth)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:yourpassword@db.your-supabase-project.supabase.co:5432/postgres

# Application Settings
COLD_START_THRESHOLD=50
